# ============================================================
# Context-Aware Smart LLM Switching - environment configuration
# Copy this file to `.env` and fill in the values.
# NEVER commit the real `.env` file.
# ============================================================

# --- Demo mode -------------------------------------------------
# When true (and no provider API keys are configured), the system
# registers built-in simulated "demo" models so the prototype runs
# out of the box and demonstrates routing behavior.
MOCK_MODELS_ENABLED=true

# --- OpenAI-compatible provider (optional) ----------------------
# Set a key to enable real models. Works with OpenAI, Azure OpenAI
# (custom base URL), OpenRouter, Groq, Ollama, etc. as long as the
# endpoint implements the OpenAI /chat/completions protocol.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Model names used for the "fast" and "powerful" tiers.
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_POWERFUL_MODEL=gpt-4o

# --- Runtime ----------------------------------------------------
REQUEST_TIMEOUT_SECONDS=60
MAX_HISTORY_MESSAGES=10

# --- Routing weights (must sum to ~1.0) -------------------------
# Quality suitability  | Complexity compatibility | Cost efficiency
# Latency efficiency   | Historical performance
W_QUALITY=0.30
W_COMPLEXITY=0.15
W_COST=0.25
W_LATENCY=0.15
W_HISTORY=0.15