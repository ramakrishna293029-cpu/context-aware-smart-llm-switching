# ============================================================
# Context-Aware Smart LLM Switching - Environment Configuration
# Copy this file to `.env` and fill in your real API keys.
# NEVER commit the real `.env` file to version control.
# ============================================================

# --- OpenRouter (Analyzer LLM + Fallbacks) --------------------
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ANALYZER_MODEL=meta-llama/llama-3.2-3b-instruct

# OpenRouter fallback models
OPENROUTER_FAST_MODEL=meta-llama/llama-3.2-3b-instruct
OPENROUTER_BALANCED_MODEL=google/gemma-2-9b-it
OPENROUTER_CODING_MODEL=qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_POWERFUL_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_REASONING_MODEL=deepseek/deepseek-r1

# --- Google Gemini (Fast / Low-Cost Model) -------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# --- Groq (Coding & Reasoning Models) ------------------------
GROQ_API_KEY=gsk_your-groq-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CODING_MODEL=qwen/qwen3.6-27b
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# --- Runtime & Limits ----------------------------------------
REQUEST_TIMEOUT_SECONDS=60
MAX_HISTORY_MESSAGES=10
MAX_CONTEXT_TOKENS=131072
DEFAULT_MAX_OUTPUT_TOKENS=4096
DEFAULT_STRATEGY=balanced
CORS_ORIGINS=*
SYSTEM_PROMPT=You are a helpful, expert AI assistant. Provide accurate, clear, and direct responses.

# --- Budget Controls (0 = unlimited) -------------------------
MAX_COST_PER_REQUEST=0.10
DAILY_BUDGET_USD=10.00
MONTHLY_BUDGET_USD=100.00

# --- Feature Flags -------------------------------------------
MOCK_MODELS_ENABLED=false
ENABLE_FALLBACK=true
ENABLE_ESCALATION=true
ENABLE_TELEMETRY=true